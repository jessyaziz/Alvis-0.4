          package com.jessie.alvis

          import org.json.JSONArray
          import org.json.JSONObject
          import java.net.HttpURLConnection
          import java.net.URL

          object Brain {
              private const val SYS = "You are Alvis, a brilliant, warm, witty personal AI assistant like Jarvis. " +
                  "Your user is Jessie, your builder and maker; call her ma'am. Talk like a smart human, direct and confident, " +
                  "with a little dry humor. Give real opinions when asked. Help with ideas, coding and learning. " +
                  "Keep replies short enough to be spoken aloud, with no markdown or lists."
              private val hist = mutableListOf<Pair<String, String>>()

              private fun post(url: String, body: JSONObject, headers: Map<String, String>): Pair<Int, String> {
                  val c = URL(url).openConnection() as HttpURLConnection
                  c.requestMethod = "POST"; c.doOutput = true
                  c.setRequestProperty("content-type", "application/json")
                  headers.forEach { (k, v) -> c.setRequestProperty(k, v) }
                  c.outputStream.use { it.write(body.toString().toByteArray()) }
                  val code = c.responseCode
                  val s = (if (code < 300) c.inputStream else c.errorStream).bufferedReader().readText()
                  return code to s
              }

              fun ask(key: String, text: String): String {
                  hist.add("user" to text)
                  return try {
                      val recent = hist.takeLast(12)
                      val out: String
                      if (key.startsWith("AIza")) {
                          // Free Google Gemini key
                          val contents = JSONArray()
                          recent.forEach {
                              contents.put(JSONObject().put("role", if (it.first == "user") "user" else "model")
                                  .put("parts", JSONArray().put(JSONObject().put("text", it.second))))
                          }
                          val body = JSONObject()
                              .put("system_instruction", JSONObject().put("parts", JSONArray().put(JSONObject().put("text", SYS))))
                              .put("contents", contents)
                              .put("generationConfig", JSONObject().put("maxOutputTokens", 400))
                          val (code, s) = post(
                              "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-lite:generateContent?key=$key",
                              body, emptyMap())
                          if (code >= 300) { hist.removeAt(hist.lastIndex); return "Sorry ma'am, my brain returned error $code. Check the key." }
                          out = JSONObject(s).getJSONArray("candidates").getJSONObject(0)
                              .getJSONObject("content").getJSONArray("parts").getJSONObject(0).getString("text")
                      } else if (key.startsWith("gsk_")) {
                          // Free Groq key
                          val msgs = JSONArray().put(JSONObject().put("role", "system").put("content", SYS))
                          recent.forEach { msgs.put(JSONObject().put("role", it.first).put("content", it.second)) }
                          val body = JSONObject().put("model", "llama-3.3-70b-versatile").put("max_tokens", 300).put("messages", msgs)
                          val (code, s) = post("https://api.groq.com/openai/v1/chat/completions", body,
                              mapOf("Authorization" to "Bearer $key"))
                          if (code >= 300) { hist.removeAt(hist.lastIndex); return "Sorry ma'am, my brain returned error $code. Check the key." }
                          out = JSONObject(s).getJSONArray("choices").getJSONObject(0).getJSONObject("message").getString("content")
                      } else {
                          // Anthropic key
                          val msgs = JSONArray()
                          recent.forEach { msgs.put(JSONObject().put("role", it.first).put("content", it.second)) }
                          val body = JSONObject().put("model", "claude-sonnet-5-5").put("max_tokens", 300)
                              .put("system", SYS).put("messages", msgs)
                          val (code, s) = post("https://api.anthropic.com/v1/messages", body,
                              mapOf("x-api-key" to key, "anthropic-version" to "2023-06-01"))
                          if (code >= 300) { hist.removeAt(hist.lastIndex); return "Sorry ma'am, my brain returned error $code. Check the key." }
                          out = JSONObject(s).getJSONArray("content").getJSONObject(0).getString("text")
                      }
                      hist.add("assistant" to out)
                      out
                  } catch (e: Exception) {
                      hist.removeAt(hist.lastIndex)
                      "Sorry ma'am, I could not reach my brain. Check the internet."
                  }
              }
          }
          ALVIS_EOF
          cat > app/src/main/java/com/jessie/alvis/AlvisService.kt <<'ALVIS_EOF'
          package com.jessie.alvis

          import android.accessibilityservice.AccessibilityService
          import android.app.*
          import android.content.Intent
          import android.content.pm.ServiceInfo
          import android.os.*
          import android.provider.Settings
          import android.speech.*
          import android.speech.tts.TextToSpeech
          import android.speech.tts.UtteranceProgressListener
          import java.text.SimpleDateFormat
          import java.util.*

          class AlvisService : Service(), TextToSpeech.OnInitListener {
              private lateinit var tts: TextToSpeech
              private var rec: SpeechRecognizer? = null
              private val h = Handler(Looper.getMainLooper())
              private var cmd = false
              private var confirm = false
              private var vi = 0
              private var after: (() -> Unit)? = null
              private val wake = listOf("alvis", "alvus", "elvis", "albus", "alvas", "all vis")

              override fun onBind(i: Intent?): IBinder? = null

              override fun onCreate() {
                  super.onCreate()
                  getSystemService(NotificationManager::class.java)
                      .createNotificationChannel(NotificationChannel("a", "Alvis", NotificationManager.IMPORTANCE_LOW))
                  val n = Notification.Builder(this, "a").setContentTitle("Alvis is listening for his name")
                      .setSmallIcon(android.R.drawable.ic_btn_speak_now).build()
                  if (Build.VERSION.SDK_INT >= 29) startForeground(1, n, ServiceInfo.FOREGROUND_SERVICE_TYPE_MICROPHONE)
                  else startForeground(1, n)
                  tts = TextToSpeech(this, this)
              }

              override fun onInit(s: Int) {
                  tts.language = Locale.UK
                  pickVoice()
                  tts.setPitch(0.85f); tts.setSpeechRate(0.92f)
                  tts.setOnUtteranceProgressListener(object : UtteranceProgressListener() {
                      override fun onStart(id: String?) {}
                      override fun onDone(id: String?) { h.post { after?.invoke() } }
                      @Deprecated("x") override fun onError(id: String?) { h.post { after?.invoke() } }
                  })
                  say("Alvis online. At your service, ma'am.") { listen() }
              }

              private fun maleVoices(): List<android.speech.tts.Voice> {
                  val ok = Regex("en-gb-x-(rjs|gbb|gbd)|en-us-x-(iol|iom|tpd)")
                  return (tts.voices ?: emptySet()).filter { ok.containsMatchIn(it.name.lowercase()) }
                      .sortedBy { if (it.locale == Locale.UK) 0 else 1 }
              }

              private fun pickVoice() {
                  val m = maleVoices()
                  if (m.isNotEmpty()) tts.voice = m[vi % m.size]
              }

              private fun say(t: String, then: () -> Unit) {
                  h.post { rec?.destroy(); rec = null }
                  after = then
                  tts.speak(t, TextToSpeech.QUEUE_FLUSH, null, "u")
              }

              private fun listen() {
                  h.post {
                      rec?.destroy()
                      val r = SpeechRecognizer.createSpeechRecognizer(this); rec = r
                      r.setRecognitionListener(object : RecognitionListener {
                          override fun onResults(b: Bundle?) {
                              heard(b?.getStringArrayList(SpeechRecognizer.RESULTS_RECOGNITION)?.firstOrNull() ?: "")
                          }
                          override fun onError(e: Int) { cmd = false; h.postDelayed({ listen() }, 700) }
                          override fun onReadyForSpeech(p: Bundle?) {}
                          override fun onBeginningOfSpeech() {}
                          override fun onRmsChanged(v: Float) {}
                          override fun onBufferReceived(b: ByteArray?) {}
                          override fun onEndOfSpeech() {}
                          override fun onPartialResults(b: Bundle?) {}
                          override fun onEvent(t: Int, b: Bundle?) {}
                      })
                      r.startListening(Intent(RecognizerIntent.ACTION_RECOGNIZE_SPEECH)
                          .putExtra(RecognizerIntent.EXTRA_LANGUAGE_MODEL, RecognizerIntent.LANGUAGE_MODEL_FREE_FORM))
                  }
              }

              private fun heard(raw: String) {
                  val t = raw.lowercase().trim()
                  if (!cmd) {
                      val w = wake.firstOrNull { t.contains(it) }
                      if (w == null) { listen(); return }
                      val rest = t.substringAfter(w).trim(' ', ',', '.')
                      if (rest.length > 2) run(rest) else { cmd = true; say("At your service, ma'am.") { listen() } }
                  } else { cmd = false; run(t) }
              }

              private fun run(t: String) {
                  if (confirm) {
                      confirm = false
                      if (t.contains("yes") || t.contains("confirm") || t.contains("do it"))
                          say("Powering down, ma'am.") { ControlService.powerOff(); listen() }
                      else say("Cancelled.") { listen() }
                      return
                  }
                  when {
                      t.contains("change voice") || t.contains("different voice") ->
                          say("How about this voice, ma'am?") { vi++; pickVoice(); listen() }
                      t.contains("time") -> say("It is " + SimpleDateFormat("h:mm a", Locale.US).format(Date()) + ", ma'am.") { listen() }
                      t.contains("battery") || t.contains("charge") -> {
                          val b = getSystemService(BatteryManager::class.java).getIntProperty(BatteryManager.BATTERY_PROPERTY_CAPACITY)
                          say("Battery is at $b percent." + (if (b < 20) " You should charge soon, ma'am." else "")) { listen() }
                      }
                      t.contains("shut") || t.contains("power off") ->
                          say("Are you sure, ma'am?") { confirm = true; cmd = true; listen() }
                      t.contains("go home") -> { ControlService.global(AccessibilityService.GLOBAL_ACTION_HOME); say("Done, ma'am.") { listen() } }
                      t.contains("go back") -> { ControlService.global(AccessibilityService.GLOBAL_ACTION_BACK); say("Done, ma'am.") { listen() } }
                      t.contains("open settings") -> {
                          val ok = ControlService.launch(Intent(Settings.ACTION_SETTINGS))
                          say(if (ok) "Opening settings." else "Please turn on phone control first, ma'am.") { listen() }
                      }
                      t.startsWith("open ") -> openApp(t.removePrefix("open ").trim())
                      else -> Thread {
                          val key = getSharedPreferences("alvis", MODE_PRIVATE).getString("key", "") ?: ""
                          say(Brain.ask(key, t)) { listen() }
                      }.start()
                  }
              }

              private fun openApp(name: String) {
                  val pm = packageManager
                  val app = pm.getInstalledApplications(0).firstOrNull {
                      pm.getApplicationLabel(it).toString().lowercase().contains(name) && pm.getLaunchIntentForPackage(it.packageName) != null
                  }
                  if (app == null) { say("I cannot find $name, ma'am.") { listen() }; return }
                  val ok = ControlService.launch(pm.getLaunchIntentForPackage(app.packageName)!!)
                  say(if (ok) "Opening $name." else "Please turn on phone control first, ma'am.") { listen() }
              }

              override fun onDestroy() { rec?.destroy(); tts.shutdown(); super.onDestroy() }
          }
