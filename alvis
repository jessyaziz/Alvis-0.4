          package com.jessie.alvis

          import android.Manifest
          import android.app.Activity
          import android.content.Intent
          import android.content.pm.PackageManager
          import android.os.Build
          import android.os.Bundle
          import android.provider.Settings
          import android.view.View
          import android.widget.*

          class MainActivity : Activity() {
              override fun onCreate(b: Bundle?) {
                  super.onCreate(b)
                  val p = getSharedPreferences("alvis", MODE_PRIVATE)
                  val col = LinearLayout(this).apply { orientation = LinearLayout.VERTICAL; setPadding(48, 96, 48, 48) }
                  val key = EditText(this).apply { hint = "Paste your Anthropic API key"; setText(p.getString("key", "")); setSingleLine() }
                  val start = Button(this).apply { text = "Start Alvis" }
                  val stop = Button(this).apply { text = "Stop Alvis" }
                  val ctl = Button(this).apply { text = "Turn on phone control" }
                  val info = TextView(this).apply {
                      text = "1) Paste your key, tap Start Alvis.\n2) Tap Turn on phone control, find Alvis, switch it on.\n3) Say: Alvis"
                  }
                  listOf<View>(key, start, stop, ctl, info).forEach { col.addView(it) }
                  setContentView(col)
                  start.setOnClickListener {
                      p.edit().putString("key", key.text.toString().trim()).apply()
                      val need = mutableListOf(Manifest.permission.RECORD_AUDIO)
                      if (Build.VERSION.SDK_INT >= 33) need.add(Manifest.permission.POST_NOTIFICATIONS)
                      requestPermissions(need.toTypedArray(), 1)
                  }
                  stop.setOnClickListener { stopService(Intent(this, AlvisService::class.java)) }
                  ctl.setOnClickListener { startActivity(Intent(Settings.ACTION_ACCESSIBILITY_SETTINGS)) }
              }

              override fun onRequestPermissionsResult(code: Int, perms: Array<out String>, res: IntArray) {
                  if (checkSelfPermission(Manifest.permission.RECORD_AUDIO) == PackageManager.PERMISSION_GRANTED)
                      startForegroundService(Intent(this, AlvisService::class.java))
              }
          }
